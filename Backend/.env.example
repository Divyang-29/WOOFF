PORT=8080
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Connection String
# For macOS local setup, default role is typically your system username (e.g., divyangchunara)
DATABASE_URL=postgresql://divyangchunara@127.0.0.1:5432/postgres
DB_POOL_MAX=20

# JWT Secret Key
JWT_SECRET=Wooff1234_SecretKey

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway & Webhook Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email SMTP Credentials (Optional)
EMAIL_USER=
EMAIL_PASS=

# Meta WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Alternative: Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Shiprocket Checkout Credentials
SHIPROCKET_CHECKOUT_API_KEY=
SHIPROCKET_CHECKOUT_SECRET_KEY=
